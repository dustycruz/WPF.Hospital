<Window x:Class="WPF.Hospital.UpdateHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        Title="UpdateHistory" Height="200" Width="450">
    <Grid Margin="5">
        <Grid.Background>
            <ImageBrush Stretch="Uniform" Opacity="0.1" ImageSource="/healthcare.png"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Update Medical History" FontWeight="Bold" Background="#FFD600"></Label>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="Patient" VerticalAlignment="Center"></Label>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                     Text="{Binding Patient.FirstName, Mode=OneWay}"
                     IsReadOnly="True">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Label Grid.Row="1" Content="Doctor" VerticalAlignment="Center"></Label>
            <ComboBox x:Name="cbxDoctor"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,3"
                      DisplayMemberPath="FirstName"
                      SelectedValuePath="Id"/>

            <Label Grid.Row="2" Content="Procedure" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtProcedure"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,3"
                     Text="{Binding Procedure, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Button x:Name="btnUpdateHistory" Grid.Row="3" Grid.ColumnSpan="2" Content="Update History" Click="btnUpdateHistory_Click" Height="30">
            </Button>
        </Grid>
    </Grid>
</Window>
