<Window x:Class="WPF.Hospital.AddPatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Add Patient" Height="250" Width="450">
    <Grid Margin="5">
        <Grid.Background>
            <ImageBrush Stretch="Uniform" Opacity="0.1" ImageSource="/healthcare.png"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Add New Patient" FontWeight="Bold" Background="#FFD600"></Label>

        <Grid Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="First Name" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtFirstName" Grid.Row="0" Grid.Column="1" Margin="0,5" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Label Grid.Row="1" Content="Last Name" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtLastName" Grid.Row="1" Grid.Column="1" Margin="0,5" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Label Grid.Row="2" Content="Age" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtAge" Grid.Row="2" Grid.Column="1" Margin="0,5" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Label Grid.Row="3" Content="Birthdate" VerticalAlignment="Center"></Label>
            <DatePicker x:Name="dpBirthdate" Grid.Row="3" Grid.Column="1" 
                        SelectedDate="{Binding Birthdate, UpdateSourceTrigger=PropertyChanged}">
                <DatePicker.Background>
                    <SolidColorBrush Opacity="0.01"/>
                </DatePicker.Background>
            </DatePicker>

            <Button x:Name="btnAddPatient" Grid.Row="4" Grid.ColumnSpan="2" Content="Add Patient" Click="btnAddPatient_Click" Height="35">
            </Button>
        </Grid>
    </Grid>
</Window>
