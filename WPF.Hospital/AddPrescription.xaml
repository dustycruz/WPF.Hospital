<Window x:Class="WPF.Hospital.AddPrescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        Title="AddPrescription" Height="200" Width="450">
    <Grid Margin="5">
        <Grid.Background>
            <ImageBrush Stretch="Uniform" Opacity="0.1" ImageSource="/healthcare.png"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Add New Prescription" FontWeight="Bold" Background="#FFD600"></Label>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition ></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="History" VerticalAlignment="Center"></Label>
            <ComboBox x:Name="cbxHistory"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,3"
                      DisplayMemberPath="HistoryInfo"
                      SelectedValuePath="Id"/>

            <Label Grid.Row="1" Content="Medicine" VerticalAlignment="Center"></Label>
            <ComboBox x:Name="cbxMedicine"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,3"
                      DisplayMemberPath="MedicineName"
                      SelectedValuePath="Id"/>

            <Label Grid.Row="2" Content="Quantity" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtQuantity" Grid.Row="2" Grid.Column="1" Margin="0,3">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Label Grid.Row="3" Content="Frequency" VerticalAlignment="Center"></Label>
            <TextBox x:Name="txtFrequency" Grid.Row="3" Grid.Column="1" Margin="0,3">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Button x:Name="btnAddPrescription" Grid.Row="4" Grid.ColumnSpan="2" Content="Add Prescription" Click="btnAddPrescription_Click" Height="30" Margin="0,5,0,-10">
            </Button>
        </Grid>
    </Grid>
</Window>
