<Window x:Class="WPF.Hospital.UpdatePatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        Title="UpdatePatient" Height="200" Width="450">
    <Grid Margin="5">
        <Grid.Background>
            <ImageBrush ImageSource="/healthcare.png" Stretch="Uniform" Opacity="0.1"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Update New Patient" FontWeight="Bold" Background="#FFD600"></Label>
        <Grid Grid.Row="1">
  
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Content="First Name"></Label>
            <TextBox  Grid.Column="1" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.1"/>
                </TextBox.Background>
            </TextBox>
            <Label Grid.Row="1" Content="Last Name"></Label>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>
            <Label Grid.Row="2" Content="Age">
                <Label.Background>
                    <SolidColorBrush Opacity="0.005"/>
                </Label.Background>
            </Label>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>
            <Label Grid.Row="3" Content="Birthdate">
                <Label.Background>
                    <SolidColorBrush Opacity="0.01"/>
                </Label.Background>
            </Label>
            <DatePicker Grid.Row="3" Grid.Column="1"
         SelectedDate="{Binding Birthdate, UpdateSourceTrigger=PropertyChanged}" >
                <DatePicker.Background>
                    <SolidColorBrush Opacity="0.01"/>
                </DatePicker.Background>
            </DatePicker>
            <Button x:Name="btnUpdatePatient" Grid.Row="4" Grid.ColumnSpan="2" Content="Update Patient" Click="btnUpdatePatient_Click">
                <Button.Background>
                    <SolidColorBrush Color="#FFDDDDDD" Opacity="0.4"/>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>
</Window>
