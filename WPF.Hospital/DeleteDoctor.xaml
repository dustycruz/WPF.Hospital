<Window x:Class="WPF.Hospital.DeleteDoctor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        Title="DeleteDoctor" Height="170" Width="400">
    <Grid Margin="5">
        <Grid.Background>
            <ImageBrush Stretch="Uniform" Opacity="0.1" ImageSource="/healthcare.png"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Delete Doctor" FontWeight="Bold" Background="#FFD600"></Label>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="Doctor ID" VerticalAlignment="Center"></Label>
            <TextBox x:Name="tbPatientId" Grid.Row="0" Grid.Column="1" Margin="0,5" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Background>
                    <SolidColorBrush Color="White" Opacity="0.01"/>
                </TextBox.Background>
            </TextBox>

            <Button x:Name="btnDeleteDoctor" Grid.Row="1" Grid.ColumnSpan="2" Content="Delete Doctor" Click="btnDeleteDoctor_Click" Height="35">
            </Button>
        </Grid>
    </Grid>
</Window>
