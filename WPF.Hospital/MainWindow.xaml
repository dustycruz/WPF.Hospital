<Window x:Class="WPF.Hospital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Hospital"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid Background="#F4F6FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.ColumnSpan="2" Background="#FFD600"
            Padding="15"
            Grid.Row="0">

            <DockPanel>

                <TextBlock Text="UAC Medical Center"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Background="#1F2937"
                Padding="15">

                <StackPanel>

                    <TextBlock Text="Maintenance"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,0,0,20"
                           FontWeight="SemiBold"/>

                    <Button x:Name="btnAddPatient"
                        Content="Add Patient"
                        Click="btnAddPatient_Click"
                        Margin="0,5"/>

                    <Button Content="Delete Patient"
                        Click="Button_Click"
                        Margin="0,5"/>

                    <Button x:Name="btnAllPatients"
                        Content="All Patients"
                        Click="btnAllPatients_Click"
                        Margin="0,5"/>

                    <Separator Margin="0,15"/>

                    <Button x:Name="btnAddMedicine"
                        Content="Add Medicine"
                        Click="btnAddMedicine_Click"
                        Margin="0,5"/>

                    <Button x:Name="btnDeleteMedicine"
                        Content="Delete Medicine"
                        Click="btnDeleteMedicine_Click"
                        Margin="0,5"/>

                    <Button x:Name="btnAllMedicine"
                        Content="All Medicine"
                        Click="btnAllMedicine_Click"
                        Margin="0,5"/>
                    <Button x:Name="btnAllPrescriptions"
                        Content="All Prescriptions"
                        Click="btnAllPrescriptions_Click"
                        />

                    <Separator Margin="0,15"/>

                    <Button x:Name="btnAddDoctor"
                        Content="Add Doctor"
                        Margin="0,5" Click="btnAddDoctor_Click"/>

                    <Button Content="Delete Doctor"
                        Margin="0,5" Click="btnDeleteDoctor_Click"/>

                    <Button x:Name="btnAllDoctor"
                        Content="All Doctors"
                        Margin="0,5" Click="btnAllDoctor_Click"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="Prescriptions"
                               Foreground="White"
                               FontSize="16"
                               Margin="0,0,0,20"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" >
                <Grid.Background>
                    <ImageBrush ImageSource="/healthcare.png" Opacity="0.1" Stretch="Uniform"></ImageBrush>
                </Grid.Background>
            </Grid>

        </Grid>
    </Grid>
</Window>
